*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -s 10.99.0.0/24 -p tcp -m tcp --dport 22 -m comment --comment "CHG-2001 mgmt ssh" -j ACCEPT
-A INPUT -p tcp -m tcp --dport 23 -j ACCEPT
-A INPUT -p tcp -m multiport --dports 80,443 -j LOG --log-prefix "WEB "
-A INPUT -p tcp -m multiport --dports 80,443 -j ACCEPT
-A INPUT -s 10.99.0.0/24 -p tcp -m tcp --dport 22 -j ACCEPT
COMMIT
